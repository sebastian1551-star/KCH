<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ekspert Odpadów: Art. 101a i 3</title>
    <style>
        :root {
            --primary: #2980b9;
            --secondary: #27ae60;
            --warning: #f39c12;
            --danger: #c0392b;
            --dark: #2c3e50;
            --light: #ecf0f1;
            --bg: #1a1a2e;
        }

        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
            margin: 0; 
            background: var(--bg); 
            color: white; 
        }

        #card-container { 
            width: 95%; 
            max-width: 600px; 
            perspective: 1000px; 
        }

        .meta { 
            text-align: center;
            color: #bdc3c7; 
            font-size: 0.9em; 
            margin-bottom: 20px; 
            text-transform: uppercase; 
            letter-spacing: 2px; 
            font-weight: bold;
        }

        .card { 
            position: relative;
            width: 100%;
            min-height: 480px;
            cursor: pointer;
            transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
            transform-style: preserve-3d;
        }

        .card.is-flipped {
            transform: rotateY(180deg);
        }

        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 40px;
            box-sizing: border-box;
            border-radius: 30px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.6);
            border: 3px solid rgba(255,255,255,0.1);
        }

        .front {
            background: linear-gradient(135deg, #ffffff 0%, #f1f2f6 100%);
            color: var(--dark);
            text-align: center;
        }

        .back {
            background: #ffffff;
            color: #333;
            transform: rotateY(180deg);
            overflow-y: auto;
            text-align: left;
        }

        .law-header {
            font-size: 0.75em;
            color: #7f8c8d;
            text-transform: uppercase;
            margin-bottom: 10px;
            letter-spacing: 1px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
        }

        .front h2 { 
            color: var(--primary); 
            margin: 20px 0; 
            font-size: 1.7em; 
            line-height: 1.2;
        }

        .front .sub-title {
            font-size: 1.1em;
            color: var(--danger);
            font-weight: bold;
        }

        .back b { color: var(--dark); }
        .back ul { padding-left: 20px; margin: 15px 0; }
        .back li { margin-bottom: 10px; font-size: 0.95em; line-height: 1.5; }
        
        .code-box { 
            background: #fdf2f2; 
            padding: 3px 8px; 
            border-radius: 5px; 
            font-family: 'Consolas', monospace; 
            font-weight: bold; 
            color: #c0392b;
            border: 1px solid #fadbd8;
        }

        .arrow-box {
            background: #ebf5fb;
            border-left: 5px solid var(--primary);
            padding: 15px;
            margin: 15px 0;
            font-size: 0.9em;
            border-radius: 4px;
        }

        .legal-stamp {
            display: inline-block;
            background: var(--dark);
            color: white;
            padding: 2px 10px;
            border-radius: 4px;
            font-size: 0.8em;
            margin-bottom: 10px;
        }

        .btn-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 40px;
        }

        button { 
            padding: 16px 35px; 
            border: none; 
            background: var(--primary); 
            color: white; 
            border-radius: 15px; 
            cursor: pointer; 
            font-size: 1em; 
            font-weight: bold; 
            transition: all 0.3s;
            box-shadow: 0 5px 0 #1b4f72;
        }

        button:hover { background: #21618c; transform: translateY(-2px); }
        button:active { transform: translateY(2px); box-shadow: 0 2px 0 #1b4f72; }
        button.secondary { background: #7f8c8d; box-shadow: 0 5px 0 #616a6b; }

        .important-red { color: #c0392b; font-weight: bold; border-bottom: 2px solid #fadbd8; }
        .green-box { border-left: 5px solid var(--secondary); background: #eafaf1; padding: 10px; margin-top: 10px; }
    </style>
</head>
<body>

<div id="card-container">
    <div class="meta">System Szkoleniowy BDO | Karta <span id="current-idx">1</span> z <span id="total-cards">4</span></div>
    
    <div class="card" id="card" onclick="flipCard()">
        <div class="card-face front">
            <div class="law-header" id="law-ref">Ustawa o odpadach</div>
            <div class="legal-stamp" id="art-ref">Art. X</div>
            <h2 id="card-title">Tytuł</h2>
            <div class="sub-title" id="card-sub">Podtytuł</div>
            <div style="font-size: 3em; margin-top: 30px;" id="card-icon">⚖️</div>
        </div>
        <div class="card-face back" id="card-back-content">
        </div>
    </div>

    <div class="btn-container">
        <button class="secondary" onclick="prevCard()">« WSTECZ</button>
        <button onclick="nextCard()">DALEJ »</button>
    </div>
</div>

<script>
    const flashcards = [
        {
            law: "Ustawa z dnia 14 grudnia 2012 r. o odpadach",
            art: "Art. 101a ust. 1",
            title: "OBOWIĄZEK SELEKTYWNEGO ZBIERANIA",
            sub: "6 FRAKCJI BUDOWLANYCH",
            icon: "🏗️",
            back: "<b>Od 1 stycznia 2025 r. wytwórca musi wydzielić:</b>" +
                  "<ul>" +
                  "<li>1. <b>Drewno</b> <span class='code-box'>17 02 01</span></li>" +
                  "<li>2. <b>Metale</b> <span class='code-box'>17 04 07</span></li>" +
                  "<li>3. <b>Szkło</b> <span class='code-box'>17 02 02</span></li>" +
                  "<li>4. <b>Tworzywa sztuczne</b> <span class='code-box'>17 02 03</span></li>" +
                  "<li>5. <b>Gips</b> <span class='code-box'>17 08 02</span></li>" +
                  "<li>6. <b>Odpady mineralne</b> (beton, cegła, ceramika)</li>" +
                  "</ul>" +
                  "<div class='arrow-box'><b>Cel:</b> Zwiększenie poziomów recyklingu i czystości surowca u źródła.</div>"
        },
        {
            law: "Ustawa o odpadach (Art. 101a ust. 2 oraz Art. 3 ust. 1 pkt 34)",
            art: "Art. 101a ust. 2",
            title: "PRZEKAZANIE OBOWIĄZKU SEGREGACJI",
            sub: "KOD 17 09 04 (ZMIESZANE)",
            icon: "📝",
            back: "<b>Zasady delegowania obowiązków:</b>" +
                  "<ul>" +
                  "<li>1. Wytwórca może zlecić segregację <b>innemu podmiotowi</b>.</li>" +
                  "<li>2. Wymagana jest forma <b>PISEMNA UMOWY</b> pod rygorem nieważności.</li>" +
                  "<li>3. <span class='important-red'>KLUCZ:</span> Zgodnie z art. 3 ust. 1 pkt 34, zbierający odpady nie może zmieniać ich kodu (sortować).</li>" +
                  "</ul>" +
                  "<div class='arrow-box'><b>Wniosek:</b> Zlecenie segregacji możliwe tylko podmiotowi prowadzącemu <b>PRZETWARZANIE</b> (Sortownia).</div>"
        },
        {
            law: "Relacja Wytwórca - Zbierający - Przetwarzający",
            art: "Analiza Ryzyka BDO",
            title: "PRAWIDŁOWY ŁAŃCUCH ZAGOSPODAROWANIA",
            sub: "CZY ZBIERAJĄCY MOŻE BYĆ POŚREDNIKIEM?",
            icon: "⛓️",
            back: "<b>Mechanizm działania pośredniego:</b>" +
                  "<ul>" +
                  "<li><b>Krok 1:</b> Wytwórca przekazuje 17 09 04 zbierającemu.</li>" +
                  "<li><b>Krok 2:</b> Zbierający musi dostarczyć odpady do <b>Instalacji Przetwarzania</b> (proces R12).</li>" +
                  "<li><b>Zagrożenie:</b> Jeśli zbierający nie przekaże odpadów do sortowni, obowiązek ustawowy wytwórcy <b>NIE ZOSTAŁ spełniony</b>.</li>" +
                  "</ul>" +
                  "<div class='arrow-box'><b>Budowa</b> ➔ <b>Umowa Pisemna</b> ➔ <b>Podmiot Przetwarzający (Sortownia)</b> ➔ <b>Odzysk</b></div>"
        },
        {
            law: "Ustawa o odpadach (Definicje legalne)",
            art: "Art. 3 ust. 1 pkt 34 vs pkt 21",
            title: "ZBIERANIE A PRZETWARZANIE",
            sub: "KLUCZOWA RÓŻNICA DLA KODU 17 09 04",
            icon: "🔍",
            back: "<b>Definicje ustawowe:</b>" +
                  "<ul>" +
                  "<li><b>ZBIERANIE (pkt 34):</b> Czasowe przechowywanie odpadów. <b>ZABRONIONE</b> jest zmienianie składu i sortowanie (zmiana kodu).</li>" +
                  "<li><b>PRZETWARZANIE (pkt 21):</b> Procesy odzysku lub unieszkodliwiania (np. R12 - sortowanie). <b>TU</b> następuje rozdział na frakcje.</li>" +
                  "</ul>" +
                  "<div class='green-box'><b>Wniosek praktyczny:</b> Jeśli firma ma w decyzji tylko 'zbieranie', nie ma prawa sortować Twoich odpadów 17 09 04!</div>"
        }
    ];

    let currentIndex = 0;
    const cardEl = document.getElementById('card');

    function updateCard() {
        cardEl.classList.remove('is-flipped');
        
        setTimeout(() => {
            const data = flashcards[currentIndex];
            document.getElementById('law-ref').innerText = data.law;
            document.getElementById('art-ref').innerText = data.art;
            document.getElementById('card-title').innerHTML = data.title;
            document.getElementById('card-sub').innerHTML = data.sub;
            document.getElementById('card-icon').innerText = data.icon;
            document.getElementById('card-back-content').innerHTML = data.back;
            document.getElementById('current-idx').innerText = currentIndex + 1;
            document.getElementById('total-cards').innerText = flashcards.length;
        }, 150);
    }

    function flipCard() {
        cardEl.classList.toggle('is-flipped');
    }

    function nextCard() {
        currentIndex = (currentIndex + 1) % flashcards.length;
        updateCard();
    }

    function prevCard() {
        currentIndex = (currentIndex - 1 + flashcards.length) % flashcards.length;
        updateCard();
    }

    updateCard();
</script>

</body>
</html>
