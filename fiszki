                  "<div class='practice-box'><b>Praktyka na budowie:</b> Wydziel zamknięty, zadaszony 'magazynek chemiczny'. Zużyte puszki po pianach poliuretanowych wrzucaj do jednego, dedykowanego pojemnika, zużyte świetlówki odkładaj osobno, a opakowania po farbach rozpuszczalnikowych segreguj oddzielnie. Nie wolno łączyć wszystkich substancji w jednym wspólnym beczkowaniu.</div>"
        },
        {
            law: "Rozporządzenie Ministra Klimatu ws. magazynowania odpadów",
            art: "§ 5 ust. 3 - 6 & § 9 ust. 1 - 4",
            title: "ZASADY OZNAKOWANIA ODPADÓW PRZEMYSŁOWYCH",
            sub: "WYMIARY I SPECYFIKACJA TECHNICZNA",
            back: "<b>Parametry techniczne znakowania (dla odpadów innych niż komunalne wytwórcy):</b>" +
                  "<ul>" +
                  "<li>1. Kody odpadów: Nanosi się cyframi koloru czarnego o wysokości minimum 20 mm i szerokości linii minimum 3 mm.</li>" +
                  "<li>2. Etykieta jednostkowa (odpady niebezpieczne > 5L): Wymiary minimum 150 mm szerokości x 210 mm wysokości.</li>" +
                  "<li>3. Treść etykiety: Napis „ODPADY NIEBEZPIECZNE”, kod, rodzaj, zawartość, adres i dokładna data rozpoczęcia magazynowania.</li>" +
                  "</ul>" +
                  "<div class='practice-box'><b>Praktyka na budowie:</b> Przygotuj lub zamów gotowe sztywne tabliczki informacyjne (np. '17 02 01 Drewno') i zamocuj je trwale na kontenerach, aby napisy były widoczne i czytelne z odległości. Na beczkach lub pojemnikach typu DPPL z zużytą chemią naklej białą kartkę formatu A5 (odpowiednik wymaganego wymiaru etykiety) z pełnymi danymi firmy oraz dokładną datą rozpoczęcia napełniania.</div>"
        }
    ];

    let currentIndex = 0;
    const cardEl = document.getElementById('card');

    function updateCard() {
        cardEl.classList.remove('is-flipped');
        
        setTimeout(() => {
            const data = flashcards[currentIndex];
            document.getElementById('law-ref').innerText = data.law.toUpperCase();
            document.getElementById('art-ref').innerText = data.art.toUpperCase();
            document.getElementById('card-title').innerHTML = data.title;
            document.getElementById('card-sub').innerHTML = data.sub;
            document.getElementById('card-back-content').innerHTML = data.back;
            document.getElementById('current-idx').innerText = currentIndex + 1;
            document.getElementById('total-cards').innerText = flashcards.length;
        }, 150);
    }

    function flipCard() {
        cardEl.classList.toggle('is-flipped');
    }

    function nextCard() {
        currentIndex = (currentIndex + 1) % flashcards.length;
        updateCard();
    }

    function prevCard() {
        currentIndex = (currentIndex - 1 + flashcards.length) % flashcards.length;
        updateCard();
    }

    updateCard();
</script>

</body>
</html>
